---
// Transient full-page splash the dashboard Worker redirects to after
// the YouTube OAuth callback. Two variants driven by ?state:
//
//   ?state=connected                       → success screen; auto-
//                                              redirects to
//                                              /dashboard/settings
//                                              after 1.5s.
//   ?state=denied&reason=<code>            → error screen; Try Again
//                                              re-enters /api/auth/youtube.
//
// The Worker's success path writes the encrypted refresh token to D1
// before landing here, so this page is decorative only. The error
// reason is mapped to fixed copy beneath the hero headline.
//
// Do not read Astro.url.searchParams here. The dashboard builds
// statically, so frontmatter runs once at build time with no query
// string, and whatever it picked would be baked into the HTML for
// every visitor. OAuthSplash reads the query string in the browser
// and sets the page title to match.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { OAuthSplash } from '../../components/OAuthSplash';
---

<BaseLayout title="YouTube connection">
  <OAuthSplash client:load />

  <script is:inline>
    (async () => {
      try {
        const r = await fetch('/api/me', { credentials: 'same-origin' });
        if (!r.ok) window.location.replace('/login');
      } catch (_e) {
        window.location.replace('/login');
      }
    })();
  </script>
</BaseLayout>
