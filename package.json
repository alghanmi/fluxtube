{
  "name": "fluxtube",
  "version": "1.2.1",
  "private": true,
  "description": "Serverless sync between Miniflux and YouTube playlists.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "bash scripts/docs-check.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "undici@<7.30.1": ">=7.30.1 <8",
      "sharp@<0.35.5": ">=0.35.5 <0.36",
      "zod@<4.6.6": ">=4.6.6 <5"
    }
  }
}
